# Pull this image instead of rebuilding the vLLM/CUDA stack.
RECIPE_IMAGE=ghcr.io/tpurtell/ds4-mia-exl3-k2-1spark:latest

# Models: k2/k2-v1 (default), k2-v0, k21/k21-v2, k21-v1, or native.
# K2.1 v2 keeps all three dSpark layers at K2 while the target experts mix
# K2/K3 according to the checkpoint's per-expert metadata.
MODEL_KIND=k2
HF_CACHE=${HOME}/.cache/huggingface
HF_HUB_OFFLINE=1
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
KV_CACHE_DTYPE=nvfp4_ds_mla
PREFIX_CACHE=1
DSPARK_TOKENS=5
DRAFT_SAMPLE_METHOD=probabilistic
DEFAULT_THINKING=max
DSPARK_MAX_INFLIGHT_PREFILLS=2
DSPARK_ISSUE43_SCHED_DIAG=0
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=4096
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
TILELANG_CACHE_DIR=/cache/huggingface/tilelang-cache
TRITON_CACHE_DIR=/cache/huggingface/triton-cache
B12X_COMPILE_CACHE_DIR=/cache/huggingface/b12x-compile-cache

# Defaults to `uni` for one Spark and `mp` for multi-Spark launches.
# DISTRIBUTED_EXECUTOR_BACKEND=uni

# Optional upstream features. Leave both disabled unless the client needs them.
DSPARK_ENABLE_ISSUE31_GPU_HOTFIX=0
DSPARK_ENABLE_ASSISTANT_FINAL_HOTFIX=0
DSPARK_SUPPRESS_STOPS_IN_REASONING=1

# Two-node launcher settings (used by ./launch.sh --nodes 2).
HEAD_HOST=kiwi
WORKER_HOST=dodo
HEAD_IP=10.55.0.4
WORKER_IP=10.55.0.2
NCCL_IB_HCA==rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
